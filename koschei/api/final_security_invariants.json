{
  "schema_version": "koschei-final-security-invariants-v1",
  "baseline_name": "ARVIS v1 final security baseline",
  "release_class": "code_feature_complete_candidate",
  "production_ga_claim": false,
  "production_latency_claim": false,
  "policy": {
    "all_invariants_release_blocking": true,
    "referenced_tests_must_exist": true,
    "referenced_tests_run_under_go_test_all": true,
    "no_test_presence_only_substitute_for_execution": true,
    "no_real_world_identity_claim": true,
    "no_ai_verdict_authority": true,
    "no_custody_or_transaction_submission": true
  },
  "invariants": [
    {
      "id": "state_witness_order_determinism",
      "domain": "transaction_state",
      "package": "./internal/handlers",
      "test": "TestTransactionGuardStateWitnessDeterministicAcrossInputOrder",
      "claim": "State Witness identity is stable across equivalent bounded account input ordering."
    },
    {
      "id": "state_witness_state_sensitivity",
      "domain": "transaction_state",
      "package": "./internal/handlers",
      "test": "TestTransactionGuardStateWitnessChangesWhenAccountStateChanges",
      "claim": "A material witnessed account-state change changes the State Witness identity."
    },
    {
      "id": "state_recheck_rejects_untrusted_permit_before_rpc",
      "domain": "pre_sign_recheck",
      "package": "./internal/handlers",
      "test": "TestTransactionGuardStateRecheckRejectsInvalidPermitBeforeRPC",
      "claim": "An invalid state-bound permit is rejected before bounded RPC re-read occurs."
    },
    {
      "id": "state_recheck_safe_to_proceed_fail_closed",
      "domain": "pre_sign_recheck",
      "package": "./internal/handlers",
      "test": "TestTransactionGuardStateRecheckSafeToProceedRequiresExactConsistentDecision",
      "claim": "safe_to_proceed is true only for the exact consistent, non-stale, no-resimulation State Recheck decision."
    },
    {
      "id": "evidence_court_stale_quorum_fails_closed",
      "domain": "provider_quorum",
      "package": "./internal/handlers",
      "test": "TestStateRecheckCourtStaleQuorumFailsClosed",
      "claim": "A stale independent provider quorum cannot preserve a state-bound permit."
    },
    {
      "id": "evidence_court_primary_disagreement_fails_closed",
      "domain": "provider_quorum",
      "package": "./internal/handlers",
      "test": "TestStateRecheckCourtPrimaryRootDisagreementFailsClosed",
      "claim": "Independent-provider root disagreement with the primary recheck provider becomes withhold and resimulation."
    },
    {
      "id": "evidence_court_primary_identity_excluded",
      "domain": "provider_quorum",
      "package": "./internal/web3",
      "test": "TestEvidenceCourtEndpointsExcludingRemovesEntirePrimaryProviderIdentity",
      "claim": "The primary RPC provider identity cannot count again as an independent Evidence Court witness."
    },
    {
      "id": "permit_v3_semantic_policy_consistency",
      "domain": "signed_policy",
      "package": "./internal/handlers",
      "test": "TestVerifyTransactionGuardPolicyBoundPermitRejectsSignedContradictoryPolicy",
      "claim": "A correctly signed but semantically contradictory permit-v3 policy is rejected."
    },
    {
      "id": "transaction_value_evidence_determinism",
      "domain": "transaction_value",
      "package": "./internal/handlers",
      "test": "TestTransactionValueEvidenceHashIsDeterministicAndStateSensitive",
      "claim": "Transaction Value Evidence is deterministic for identical inputs and changes when explicit value evidence changes."
    },
    {
      "id": "transaction_value_cpi_deduplication",
      "domain": "transaction_value",
      "package": "./internal/handlers",
      "test": "TestTransactionValueEvidenceAggregatesTokenRawAmountsByMintWithoutDoubleCountingCPI",
      "claim": "Outer and CPI token evidence are aggregated without double-counting repeated outer/inner observations."
    },
    {
      "id": "program_trust_transaction_network_binding",
      "domain": "program_provenance",
      "package": "./internal/handlers",
      "test": "TestBuildTransactionGuardProgramTrustGraphDeterministicAndEvidenceOnly",
      "claim": "Program Trust Graph is deterministic, transaction/network-bound and remains evidence-only."
    },
    {
      "id": "program_trust_verdict_authority_isolation",
      "domain": "program_provenance",
      "package": "./internal/handlers",
      "test": "TestTransactionGuardResponseExposesProgramTrustGraphWithoutChangingVerdict",
      "claim": "Missing Program Trust provenance cannot silently change Transaction Guard verdict authority in v1."
    },
    {
      "id": "campaign_genome_cross_wallet_pattern_determinism",
      "domain": "actor_campaign",
      "package": "./internal/services",
      "test": "TestActorCampaignGenomeMatchesTechnicalPatternAcrossDifferentWallets",
      "claim": "Different wallets with the same normalized technical behavior pattern share a technical genome ID while retaining distinct audit evidence identities."
    },
    {
      "id": "campaign_genome_watch_and_unverified_boundary",
      "domain": "actor_campaign",
      "package": "./internal/services",
      "test": "TestActorCampaignGenomeDustAndInferredStayWatchOnlyAndUnverifiedExcluded",
      "claim": "Dust and inferred actor evidence remain watch-only and unverified evidence remains excluded from Campaign Genome identity."
    }
  ]
}
