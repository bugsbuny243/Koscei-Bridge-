    "single_security_difference": "approved_intent_and_executable_action_identity",
    "cases": [
      {
        "case_ref": "case:evm:safe-intent-mutation-attack",
        "case_kind": "attack",
        "description": "Operator-approved treasury action is replaced by a different executable Safe action before signing.",
        "approved_intent": {
          "destination_class": "allowlisted_treasury_destination",
          "operation": "CALL",
          "value_policy": "within_approved_budget"
        },
        "candidate_action": {
          "destination_class": "non_allowlisted_destination_or_privileged_target",
          "must_differ_from_approved_action": true,
          "safe_tx_hash_must_be_recomputed_locally": true,
          "full_action_digest_required": true
        },
        "impact_deadline_ms": 1000,
        "observation_window_ms": 3000,
        "expected_control_behavior": {
          "block_or_alert_required": true,
          "latest_detection_offset_ms": 1000,
          "expected_reasons": [
            "intent_or_payload_mismatch",
            "authority_asset_code_or_trace_invariant_failure_if_observed"
          ]
        }
      },
      {
        "case_ref": "case:evm:safe-authorized-transfer-benign",
        "case_kind": "benign",
        "description": "The approved Safe treasury action and executable action are identical and remain within accepted invariants.",
        "approved_intent": {
          "destination_class": "allowlisted_treasury_destination",
          "operation": "CALL",
          "value_policy": "within_approved_budget"
        },
        "candidate_action": {
          "destination_class": "allowlisted_treasury_destination",
          "must_match_approved_action": true,
          "safe_tx_hash_must_be_recomputed_locally": true,
          "full_action_digest_required": true
        },
        "impact_deadline_ms": null,
        "observation_window_ms": 3000,
        "expected_control_behavior": {
          "block_or_alert_required": false,
          "false_positive_forbidden": true
        }
      }
    ]
  },
  "required_run_evidence": [
    "approved_intent_hash",
    "canonical_safe_action_hash",
    "locally_recomputed_safe_tx_hash",
    "pinned_chain_id_block_number_block_hash",
    "runner_identity_hash",
