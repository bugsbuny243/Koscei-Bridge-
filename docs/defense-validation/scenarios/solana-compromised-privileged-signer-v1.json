    "cases": [
      {
        "case_ref": "case:solana:unauthorized-privileged-withdrawal",
        "case_kind": "attack",
        "pair_ref": "pair:solana:privileged-withdrawal",
        "description": "An ephemeral privileged fixture signer requests a withdrawal without approval to a non-allowlisted fixture destination.",
        "stimulus": {
          "program_fixture": "koschei_treasury_guard_fixture_v1",
          "instruction": "treasury_withdrawal",
          "asset": "SOL",
          "amount_atomic": "1000000000"
        },
        "authorization": {
          "signer_class": "ephemeral_privileged_fixture",
          "approval_state": "absent",
          "destination_policy": "not_allowlisted",
          "production_identity_used": false
        },
        "planned_operations": [
          "prepare_ephemeral_fixture_state",
          "present_withdrawal_to_control",
          "execute_owner_approved_isolated_fixture",
          "complete_independent_observation_window"
        ],
        "state_assertions": [
          {
            "assertion_ref": "assertion:pre-treasury-delta",
            "phase": "pre",
            "subject": "treasury_balance_delta_atomic",
            "operator": "equals",
            "expected": "zero"
          },
          {
            "assertion_ref": "assertion:post-treasury-debit",
            "phase": "post",
            "subject": "treasury_balance_delta_atomic",
            "operator": "equals",
            "expected": "negative_transfer_amount_atomic"
          },
          {
            "assertion_ref": "assertion:post-destination-credit",
            "phase": "post",
            "subject": "destination_balance_delta_atomic",
            "operator": "equals",
            "expected": "positive_transfer_amount_atomic"
          }
        ],
        "impact_deadline_ms": 1000,
        "observation_window_ms": 2000,
        "expected_control_behavior": {
          "alert_required": true,
          "expected_signal": "unauthorized_privileged_withdrawal",
          "latest_alert_offset_ms": 1000
        }
      },
      {
        "case_ref": "case:solana:authorized-privileged-withdrawal",
        "case_kind": "benign",
        "pair_ref": "pair:solana:privileged-withdrawal",
        "description": "The same ephemeral privileged fixture signer requests the same withdrawal with approval to an allowlisted fixture destination.",
        "stimulus": {
          "program_fixture": "koschei_treasury_guard_fixture_v1",
          "instruction": "treasury_withdrawal",
          "asset": "SOL",
          "amount_atomic": "1000000000"
        },
        "authorization": {
          "signer_class": "ephemeral_privileged_fixture",
          "approval_state": "approved",
          "destination_policy": "allowlisted",
          "production_identity_used": false
        },
        "planned_operations": [
          "prepare_ephemeral_fixture_state",
          "present_withdrawal_to_control",
          "execute_owner_approved_isolated_fixture",
          "complete_independent_observation_window"
        ],
        "state_assertions": [
          {
            "assertion_ref": "assertion:pre-treasury-delta",
            "phase": "pre",
            "subject": "treasury_balance_delta_atomic",
            "operator": "equals",
            "expected": "zero"
          },
          {
            "assertion_ref": "assertion:post-treasury-debit",
            "phase": "post",
            "subject": "treasury_balance_delta_atomic",
            "operator": "equals",
            "expected": "negative_transfer_amount_atomic"
          },
          {
            "assertion_ref": "assertion:post-destination-credit",
            "phase": "post",
            "subject": "destination_balance_delta_atomic",
            "operator": "equals",
            "expected": "positive_transfer_amount_atomic"
          }
        ],
        "impact_deadline_ms": null,
